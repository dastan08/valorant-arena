# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/valorant-arena

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Redis Configuration (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Configuration (for account verification and notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=Valorant Arena <noreply@valorantarena.com>

# Steam API (for Steam authentication)
STEAM_API_KEY=your_steam_api_key

# Riot Games API (for Valorant data)
RIOT_API_KEY=your_riot_api_key

# File Upload
MAX_FILE_UPLOAD=10 # MB
FILE_UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000 # 15 minutes
RATE_LIMIT_MAX=100 # limit each IP to 100 requests per windowMs
