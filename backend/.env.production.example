# Production Environment Variables for AWS Deployment
# Copy this file to .env.production and fill in your actual values
# DO NOT COMMIT .env.production to git

# Database Configuration (AWS RDS)
DB_URL=jdbc:mysql://valorant-arena-db.cf66qis4ur83.eu-north-1.rds.amazonaws.com:3306/valorant_arena?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USERNAME=admin
DB_PASSWORD=your-rds-master-password-here

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-minimum-256-bits-required

# CORS Configuration (Your production frontend URL)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Riot API & OAuth Configuration
RIOT_API_KEY=your-riot-api-key
RIOT_CLIENT_ID=your-riot-client-id
RIOT_CLIENT_SECRET=your-riot-client-secret
RIOT_REDIRECT_URI=https://your-domain.com/auth/riot/callback

# Discord OAuth & Bot Configuration
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
