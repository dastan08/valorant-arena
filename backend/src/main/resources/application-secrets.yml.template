# Sensitive configuration - DO NOT COMMIT TO GIT
# Copy this file to application-secrets.yml and fill in your actual secrets
# application-secrets.yml is gitignored and will not be committed

# Database Configuration
# For local development (MySQL on localhost)
database:
  url: jdbc:mysql://localhost:3306/valorant_arena?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
  username: root
  password: your-database-password

# For AWS RDS Production (uncomment and use these instead)
# database:
#   url: jdbc:mysql://valorant-arena-db.cf66qis4ur83.eu-north-1.rds.amazonaws.com:3306/valorant_arena?useSSL=true&requireSSL=true&serverTimezone=UTC
#   username: admin
#   password: your-rds-master-password

# JWT Configuration
jwt:
  secret: your-jwt-secret-key-minimum-256-bits-required

# Riot API & OAuth Configuration
riot:
  api:
    key: your-riot-api-key
  oauth:
    client-id: your-riot-client-id
    client-secret: your-riot-client-secret

# Discord OAuth & Bot Configuration
discord:
  client-id: your-discord-client-id
  client-secret: your-discord-client-secret
  bot:
    token: your-discord-bot-token
